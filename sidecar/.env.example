# 主 LLM provider（任意 OpenAI 兼容端点）。任选其一，取消注释填入。
# 旧名 YIBAO_GLM_* 仍向后兼容（作为回退）。

# —— 智谱 GLM（项目原生；支持视觉 computer-use 兜底）——
YIBAO_LLM_API_KEY=your_zhipu_api_key_here
YIBAO_LLM_MODEL=glm-4.6
# YIBAO_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# —— DeepSeek（OpenAI 兼容；支持流式 + function calling，无视觉模型）——
# YIBAO_LLM_API_KEY=sk-your_deepseek_key
# YIBAO_LLM_MODEL=deepseek-chat
# YIBAO_LLM_BASE_URL=https://api.deepseek.com

# —— 独立视觉 provider（主 LLM 使用 DeepSeek 等无视觉端点时配置）——
# 未配置时自动回退主 provider；旧 YIBAO_GLM_API_KEY/BASE_URL 也可作为视觉回退。
# YIBAO_VISION_API_KEY=your_zhipu_api_key_here
# YIBAO_VISION_MODEL=glm-4.6v-flash
# YIBAO_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# mem0 长期记忆（本地：LLM 抽取 + 本地 embedder 向量化 + 本地 qdrant 库，免外部服务）
# 依赖 [memory] extra：uv sync --extra dev --extra memory
# YIBAO_MEM0_EMBEDDER=BAAI/bge-small-zh-v1.5   # 本地 embedder，中文 512 维 ~100MB
# YIBAO_MEM0_EMBED_DIM=512                      # 须与 embedder 维度匹配
# YIBAO_MEM0_VECTOR_PATH=./mem0_store           # qdrant 本地库路径（持久，跨会话）

# 语音（可选调参）
# YIBAO_VAD_MIN_SILENCE=0.9    # VAD 判定「说完」的静音秒数；说长句被切断就调大（如 1.2）
# YIBAO_VAD_MAX_SECONDS=30     # 单次录音最长秒数
# YIBAO_TTS_VOICE=zh-CN-XiaoxiaoNeural   # edge-tts 音色
# TTS 引擎：edge | cosyvoice | cosyvoice_cloud（默认 edge；也可在设置页「合成引擎」选，重启生效）
# YIBAO_TTS_PROVIDER=edge
# 本地 CosyVoice2（离线·可零样本克隆）：uv sync --extra tts-local；模型 FunAudioLLM/CosyVoice2-0.5B
# YIBAO_COSYVOICE_MODEL=                 # 模型目录；留空 = 本地 provider 不可用
# YIBAO_COSYVOICE_VOICE=中文女           # 预置音色（无 PROMPT_AUDIO 时用）
# YIBAO_COSYVOICE_PROMPT_AUDIO=          # 克隆参考音频路径；留空 = 用预置音色
# YIBAO_COSYVOICE_PROMPT_TEXT=           # 参考音频台词（克隆必需）
# 云 CosyVoice（阿里云百炼 dashscope）：pip install dashscope；需百炼 API key
# YIBAO_COSYVOICE_CLOUD_KEY=
# YIBAO_COSYVOICE_CLOUD_MODEL=cosyvoice-v1
# YIBAO_COSYVOICE_CLOUD_VOICE=
# YIBAO_SEARCH_ENGINE=baidu    # web_search 技能：baidu/bing/google
