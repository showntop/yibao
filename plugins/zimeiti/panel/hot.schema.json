{
  "version": 1,
  "type": "list",
  "bind": {"items": "$data.rows"},
  "item": {
    "title": "$item.title",
    "subtitle": "$item.meta",
    "actions": [
      {"label": "转选题", "method": "zimeiti.hot_add", "params": {"title": "$item.title", "source": "$item.source_ref"}},
      {"label": "存素材", "method": "zimeiti.hot_mat_save", "params": {"url": "$item.url"}}
    ]
  }
}
