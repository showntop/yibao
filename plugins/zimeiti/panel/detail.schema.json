{
  "version": 1,
  "type": "detail",
  "back": {"label": "返回看板", "method": "zimeiti.list"},
  "fields": [
    {"label": "标题", "value": "$data.rows.0.title"},
    {"label": "角度", "value": "$data.rows.0.angle"},
    {"label": "平台", "value": "$data.rows.0.platform"},
    {"label": "来源", "value": "$data.rows.0.source"},
    {"label": "链接", "value": "$data.rows.0.url"},
    {"label": "视频平台", "value": "$data.rows.0.target_platform"},
    {"label": "钩型", "value": "$data.rows.0.hook_type"},
    {"label": "快乐", "value": "$data.rows.0.hkrr_happy"},
    {"label": "知识", "value": "$data.rows.0.hkrr_knowledge"},
    {"label": "共鸣", "value": "$data.rows.0.hkrr_resonance"},
    {"label": "节奏", "value": "$data.rows.0.hkrr_rhythm"},
    {"label": "封面A", "value": "$data.rows.0.cover_1"},
    {"label": "封面B", "value": "$data.rows.0.cover_2"},
    {"label": "封面C", "value": "$data.rows.0.cover_3"},
    {"label": "状态", "value": "$data.rows.0.status"},
    {"label": "项目", "value": "$data.rows.0.project"},
    {"label": "稿件", "value": "$data.rows.0.draft"},
    {"label": "素材", "value": "$data.rows.0.materials"},
    {"label": "发布", "value": "$data.rows.0.published_at|date"},
    {"label": "创建", "value": "$data.rows.0.created_at|date"},
    {"label": "更新", "value": "$data.rows.0.updated_at|date"}
  ],
  "actions": [
    {"label": "立项", "method": "zimeiti.promote", "params": {"id": "$data.rows.0.id", "title": "$data.rows.0.title"}},
    {"label": "打开编辑器", "method": "zimeiti.open_editor", "params": {"id": "$data.rows.0.id", "title": "$data.rows.0.title"}},
    {"label": "写初稿", "method": "zimeiti.draft", "params": {"id": "$data.rows.0.id", "title": "$data.rows.0.title"}},
    {"label": "改稿", "method": "zimeiti.revise", "params": {"id": "$data.rows.0.id", "title": "$data.rows.0.title"}},
    {"label": "读稿", "method": "zimeiti.read", "params": {"id": "$data.rows.0.id", "title": "$data.rows.0.title"}},
    {"label": "复盘", "method": "zimeiti.review", "params": {"title": "$data.rows.0.title", "id": "$data.rows.0.id"}},
    {"label": "录数据", "method": "zimeiti.record", "params": {"id": "$data.rows.0.id"}},
    {"label": "复制成稿", "method": "zimeiti.publish", "params": {"id": "$data.rows.0.id"}},
    {"label": "待发布", "method": "zimeiti.move", "params": {"id": "$data.rows.0.id", "status": "待发布"}},
    {"label": "删除", "method": "zimeiti.delete", "params": {"id": "$data.rows.0.id"}}
  ]
}
