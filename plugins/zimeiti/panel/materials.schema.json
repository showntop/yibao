{
  "version": 1,
  "type": "list",
  "back": {"label": "返回看板", "method": "zimeiti.list"},
  "bind": {"items": "$data.rows"},
  "item": {
    "title": "$item.title",
    "subtitle": "$item.summary",
    "actions": [
      {"label": "删除", "method": "zimeiti.mat_delete", "params": {"id": "$item.id"}}
    ]
  }
}
